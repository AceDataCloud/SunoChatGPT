APP_PROFILE=suno
# Valid: suno, seedance, happyhorse, gpt-image, nano-banana
# No real credentials. Production readback boundary must be implemented first.
PUBLIC_ORIGIN=https://suno-app.example.invalid
OAUTH_ISSUER=https://auth.example.invalid/
OAUTH_JWKS_URL=https://auth.example.invalid/.well-known/jwks.json
OAUTH_AUDIENCE=https://suno-app.example.invalid/mcp
# A trusted owner-scoped readback adapter, NOT an existing public Ace endpoint.
OWNED_TASK_READBACK_URL=https://internal.example.invalid/read-owned-music-task
OWNED_TASK_READBACK_TOKEN=
PORT=8000
